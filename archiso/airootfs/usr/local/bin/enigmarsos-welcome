#!/usr/bin/env python3
"""EnigmarsOS Welcome — first-run / always-available companion app."""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
import webbrowser
from pathlib import Path

# Prefer PySide6, fall back to PyQt6
try:
    from PySide6.QtCore import Qt, QSize, QProcess
    from PySide6.QtGui import QFont, QIcon, QPixmap, QColor, QPalette
    from PySide6.QtWidgets import (
        QApplication,
