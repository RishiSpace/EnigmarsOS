#!/usr/bin/env bash
set -euo pipefail
cat >/usr/lib/os-release <<'OS'
NAME="EnigmarsOS"
PRETTY_NAME="EnigmarsOS"
ID=enigmarsos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="0;36"
HOME_URL="https://enigmarsos.rishispace.dev/"
DOCUMENTATION_URL="https://enigmarsos.rishispace.dev/docs/"
SUPPORT_URL="https://github.com/RishiSpace/EnigmarsOS/issues"
BUG_REPORT_URL="https://github.com/RishiSpace/EnigmarsOS/issues"
PRIVACY_POLICY_URL="https://enigmarsos.rishispace.dev/privacy"
LOGO=enigmarsos
OS
install -Dm644 /usr/lib/os-release /etc/os-release
if [[ ! -f /etc/motd ]] || ! grep -q EnigmarsOS /etc/motd 2>/dev/null; then
cat >/etc/motd <<'MOTD'
Welcome to EnigmarsOS

  Privacy first · Secure by default · Ready immediately

MOTD
fi
