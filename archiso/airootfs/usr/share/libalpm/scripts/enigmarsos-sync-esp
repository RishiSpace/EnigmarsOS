#!/bin/bash
# alpm hook helper — stage kernels onto the ESP after kernel updates.
# On an installed system with /boot/efi in fstab, failure MUST fail the
# transaction. Discover/PackageKit otherwise reports success and reboot
# into a stale Limine kernel (emergency mode: Failed to mount /boot/efi).
set -u

SCRIPT=/usr/share/enigmarsos/scripts/sync-esp-boot.sh

if [[ ! -x "${SCRIPT}" ]]; then
  echo "enigmarsos-sync-esp: missing ${SCRIPT}" >&2
  # Live ISO / incomplete image
  [[ -d /run/archiso ]] && exit 0
  exit 1
fi

# Skip mkarchiso / packaging chroots with no real firmware + no fstab
if [[ ! -d /sys/firmware ]] && [[ ! -e /etc/fstab ]]; then
  exit 0
fi

# Live USB: do not fail pacstrap/ISO builds
if [[ -d /run/archiso ]]; then
  "${SCRIPT}" || true
  exit 0
fi

if ! "${SCRIPT}"; then
  echo "" >&2
  echo "ERROR: EnigmarsOS could not stage the kernel onto the ESP." >&2
  echo "       Reboot would load a stale Limine kernel and drop to" >&2
  echo "       emergency mode (Failed to mount /boot/efi)." >&2
  echo "       Mount the ESP and run: sudo ${SCRIPT}" >&2
  echo "" >&2
  if grep -qE '[[:space:]]/boot/efi[[:space:]]' /etc/fstab 2>/dev/null; then
    exit 1
  fi
  exit 0
fi

exit 0
