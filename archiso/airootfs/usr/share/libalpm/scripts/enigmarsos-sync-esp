#!/bin/bash
# alpm hook helper — never fail the pacman transaction hard if ESP is missing
# during chroot edge cases; still surface errors clearly.
set -u

SCRIPT=/usr/share/enigmarsos/scripts/sync-esp-boot.sh

if [[ ! -x "${SCRIPT}" ]]; then
  echo "enigmarsos-sync-esp: missing ${SCRIPT}" >&2
  exit 0
fi

# Skip on live ISO / airootfs packaging environments without a real ESP
if [[ ! -d /sys/firmware ]] && [[ ! -e /etc/fstab ]]; then
  exit 0
fi

if ! "${SCRIPT}"; then
  echo "" >&2
  echo "WARNING: EnigmarsOS could not stage the kernel onto the ESP." >&2
  echo "         After reboot Limine may load a stale kernel and drop to" >&2
  echo "         emergency mode (Failed to mount /boot/efi)." >&2
  echo "         Fix: mount the ESP and run:" >&2
  echo "           sudo ${SCRIPT}" >&2
  echo "" >&2
  # Exit 0 so pacman itself still succeeds; user sees the warning.
  exit 0
fi

exit 0
