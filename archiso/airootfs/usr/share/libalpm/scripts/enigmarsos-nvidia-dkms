#!/bin/bash
# After nvidia-open-dkms: retry DKMS for chroot kernels that have headers.
# Pacman's AbortOnFail is ignored on PostTransaction hooks — the ISO
# builder (docker/entrypoint.sh) fails the job if nvidia.ko is still missing.
set -euo pipefail

# ISO pacstrap only. Installed systems keep Arch's 70-dkms-install.hook.
if [[ ! -f /etc/enigmarsos/iso-build ]]; then
  exit 0
fi

if ! pacman -Qq nvidia-open-dkms >/dev/null 2>&1 && ! pacman -Qq nvidia-dkms >/dev/null 2>&1; then
  exit 0
fi

if [[ ! -e /etc/os-release ]]; then
  if [[ -e /usr/lib/os-release ]]; then
    rm -f /etc/os-release
    cp -f /usr/lib/os-release /etc/os-release
  else
    echo "ERROR: /etc/os-release missing; DKMS cannot build NVIDIA modules" >&2
    exit 1
  fi
fi

dump_nvidia_logs() {
  local log
  shopt -s nullglob
  for log in /var/lib/dkms/nvidia/*/build/make.log; do
    echo "==> ${log} (last 120 lines)" >&2
    tail -n 120 "${log}" >&2 || true
  done
  shopt -u nullglob
}

# Do not use `dkms autoinstall`: in the GHA container uname -r is the
# Ubuntu host (e.g. 6.17.0-*-azure), which has no headers in the chroot.
shopt -s nullglob
nvidia_src=(/usr/src/nvidia-*)
shopt -u nullglob
if ((${#nvidia_src[@]})); then
  ver="${nvidia_src[0]##*/nvidia-}"
  for kdir in /usr/lib/modules/*; do
    [[ -d "${kdir}/build" ]] || continue
    kver="$(basename "${kdir}")"
    [[ "${kver}" == *azure* ]] && continue
    echo "==> dkms install nvidia/${ver} -k ${kver}"
    if ! dkms install "nvidia/${ver}" -k "${kver}"; then
      echo "ERROR: dkms install nvidia/${ver} failed for ${kver}" >&2
      dump_nvidia_logs
    fi
  done
else
  dkms autoinstall || true
  dump_nvidia_logs
fi

missing=0
for kdir in /usr/lib/modules/*; do
  [[ -d "${kdir}/build" ]] || continue
  kver="$(basename "${kdir}")"
  [[ "${kver}" == *azure* ]] && continue
  if ! find "${kdir}" \( -name 'nvidia.ko' -o -name 'nvidia.ko.*' \) 2>/dev/null | grep -q .; then
    echo "ERROR: nvidia.ko missing for kernel ${kver} after dkms install" >&2
    missing=1
  else
    echo "==> nvidia.ko present for ${kver}"
  fi
done

if pacman -Qq linux-enigmarsos-lts >/dev/null 2>&1; then
  if ! find /usr/lib/modules/*enigmarsos-lts* \( -name 'nvidia.ko' -o -name 'nvidia.ko.*' \) 2>/dev/null | grep -q .; then
    echo "ERROR: nvidia.ko missing for linux-enigmarsos-lts (live default kernel)" >&2
    missing=1
  fi
fi

if [[ "${missing}" -ne 0 ]]; then
  dump_nvidia_logs
fi
exit "${missing}"
