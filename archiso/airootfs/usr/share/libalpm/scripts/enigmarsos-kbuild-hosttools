#!/bin/bash
# linux-enigmarsos-lts is x86-64-v2, but -headers still ships prebuilt
# kbuild host tools (fixdep, modpost) from the packager's machine. If that
# machine is v3, glibc on GitHub Actions aborts them:
#   CPU ISA level is lower than required
# Rebuild those tools here with a baseline ISA so NVIDIA DKMS can run.
# The kernel image itself is unchanged.
set -euo pipefail

if [[ ! -f /etc/enigmarsos/iso-build ]]; then
  exit 0
fi

rebuild_scripts() {
  local build="$1"
  local fixdep="${build}/scripts/basic/fixdep"
  [[ -d "${build}/scripts/basic" ]] || return 0

  local rc=0
  local err=""
  if [[ -x "${fixdep}" ]]; then
    err="$("${fixdep}" 2>&1)" || rc=$?
    if [[ "${err}" != *"CPU ISA level"* && "${rc}" -ne 127 ]]; then
      return 0
    fi
  fi

  echo "==> Rebuilding kbuild host tools in ${build} with -march=x86-64"
  find "${build}/scripts" -type f -executable \
    ! -name '*.sh' ! -name '*.py' ! -name '*.pl' -delete 2>/dev/null || true
  make -C "${build}" scripts \
    HOSTCC=gcc \
    HOSTCFLAGS="-O2 -std=gnu11 -march=x86-64"
}

for kdir in /usr/lib/modules/*; do
  [[ -d "${kdir}/build" ]] || continue
  kver="$(basename "${kdir}")"
  [[ "${kver}" == *azure* ]] && continue
  rebuild_scripts "${kdir}/build"
done
