pkgname=enigmaos-calamares-config
pkgver=1.0.0
pkgrel=1
pkgdesc="Calamares configuration and branding for EnigmaOS"
arch=('any')
url="https://enigmaos.rishispace.dev"
license=('GPL-3.0-or-later')
depends=('calamares')
provides=('calamares-settings')
source=()
sha256sums=()

package() {
  install -d "$pkgdir/etc/calamares"
  echo "Injected by package build from calamares/" > "$pkgdir/etc/calamares/.enigmaos"
}
