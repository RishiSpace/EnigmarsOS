# Maintainer: EnigmaOS Team <rishi@rishispace.dev>
pkgname=enigmaos-settings
pkgver=1.0.0
pkgrel=1
pkgdesc="EnigmaOS default settings (security, Plasma, shell, NetworkManager)"
arch=('any')
url="https://enigmaos.rishispace.dev"
license=('GPL-3.0-or-later')
depends=('enigmaos-filesystem')
source=()
sha256sums=()

package() {
  # Packaged from repo configs at build time by scripts/package-settings.sh
  # This PKGBUILD is a template; release script injects files.
  install -d "$pkgdir/usr/share/enigmaos/settings"
  echo "EnigmaOS settings package ${pkgver}" > "$pkgdir/usr/share/enigmaos/settings/VERSION"
}
