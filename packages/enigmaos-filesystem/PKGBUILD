# Maintainer: EnigmaOS Team <rishi@rishispace.dev>
pkgname=enigmaos-filesystem
pkgver=1.0.0
pkgrel=1
pkgdesc="EnigmaOS base filesystem identity (os-release, issue, motd)"
arch=('any')
url="https://enigmaos.rishispace.dev"
license=('GPL-3.0-or-later')
depends=('filesystem')
provides=('enigmaos-identity')
conflicts=()
source=()
sha256sums=()

package() {
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/os-release" <<'OS'
NAME="EnigmaOS"
PRETTY_NAME="EnigmaOS"
ID=enigmaos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="0;36"
HOME_URL="https://enigmaos.rishispace.dev/"
DOCUMENTATION_URL="https://enigmaos.rishispace.dev/docs/"
SUPPORT_URL="https://github.com/RishiSpace/EnigmaOS/issues"
BUG_REPORT_URL="https://github.com/RishiSpace/EnigmaOS/issues"
PRIVACY_POLICY_URL="https://enigmaos.rishispace.dev/privacy"
LOGO=enigmaos
OS
  install -Dm644 /dev/stdin "$pkgdir/etc/issue" <<'ISSUE'
EnigmaOS \r (\l)

ISSUE
  install -Dm644 /dev/stdin "$pkgdir/etc/motd" <<'MOTD'
Welcome to EnigmaOS

  Privacy first · Secure by default · Ready immediately

  Docs:     https://enigmaos.rishispace.dev/docs
  Website:  https://enigmaos.rishispace.dev
MOTD
}
