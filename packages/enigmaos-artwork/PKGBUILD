# Maintainer: EnigmaOS Team <rishi@rishispace.dev>
pkgname=enigmaos-artwork
pkgver=1.0.0
pkgrel=1
pkgdesc="EnigmaOS logos, wallpapers and color schemes"
arch=('any')
url="https://enigmaos.rishispace.dev"
license=('GPL-3.0-or-later')
source=()
sha256sums=()

package() {
  install -d "$pkgdir/usr/share/enigmaos/"{logos,wallpapers}
  install -d "$pkgdir/usr/share/backgrounds/enigmaos"
  install -d "$pkgdir/usr/share/color-schemes"
  install -d "$pkgdir/usr/share/pixmaps"
  # Files copied by build script from branding/ and wallpapers/
  echo "${pkgver}" > "$pkgdir/usr/share/enigmaos/artwork-version"
}
