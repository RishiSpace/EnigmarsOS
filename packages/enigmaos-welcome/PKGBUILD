# Maintainer: EnigmaOS Team <rishi@rishispace.dev>
pkgname=enigmaos-welcome
pkgver=1.0.0
pkgrel=1
pkgdesc="EnigmaOS welcome application"
arch=('any')
url="https://enigmaos.rishispace.dev"
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'qt6-base')
optdepends=(
  'konsole: terminal for system updates'
  'plasma-discover: software center integration'
)
source=(
  'enigmaos-welcome'
  'enigmaos-welcome.desktop'
)
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 enigmaos-welcome "$pkgdir/usr/bin/enigmaos-welcome"
  install -Dm644 enigmaos-welcome.desktop \
    "$pkgdir/usr/share/applications/enigmaos-welcome.desktop"
  install -Dm644 enigmaos-welcome.desktop \
    "$pkgdir/etc/xdg/autostart/enigmaos-welcome.desktop"
}
